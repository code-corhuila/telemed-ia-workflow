# Names and placeholders only: never a real value. Copy to .env for local runs.
PORT=8080
# Public key (PEM) of the identity service, used to verify RS256 access tokens. Not a secret,
# but it must match the identity key of the environment.
JWT_PUBLIC_KEY=
# Participants of the onboarding saga, inside the platform network (they are not called through the gateway).
IDENTITY_URL=http://identity-and-access-api:8081
PROFESSIONAL_MANAGEMENT_URL=http://professional-management-api:8080
# The workflow's own service client at identity's POST /internal/service-token. Identity keeps only the
# hash of the secret (SERVICE_CLIENTS); the value lives in your local .env, never here.
WORKFLOW_CLIENT_ID=workflow
WORKFLOW_CLIENT_SECRET=
WORKFLOW_TOKEN_REFRESH_MARGIN=PT60S
PARTICIPANT_CONNECT_TIMEOUT=PT2S
PARTICIPANT_REQUEST_TIMEOUT=PT5S
PARTICIPANT_ATTEMPTS=3
PARTICIPANT_BACKOFF=PT0.5S
